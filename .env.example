# Neon pooled connection string (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend password-reset email delivery
RESEND_API_KEY=""
EMAIL_FROM="Lenni <no-reply@yourdomain.com>"

# Imole server-side API configuration
IMOLE_API_KEY=""
IMOLE_BASE_URL="https://api.imole.app/v1"
IMOLE_MODEL="gpt-5.6-luna"
